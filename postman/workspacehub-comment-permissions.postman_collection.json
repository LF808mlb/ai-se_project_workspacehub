{
  "info": {
    "_postman_id": "9d7d0e11-13ad-4ae9-9b9f-4d80fc2f3d65",
    "name": "WorkspaceHub Comment Permissions",
    "description": "Verifies that comment authors, organization admins, and organization owners may edit and delete comments, while other members are denied.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "password",
      "value": "Password123!"
    },
    {
      "key": "ownerEmail",
      "value": "owner@workspacehub.dev"
    },
    {
      "key": "adminEmail",
      "value": "admin@workspacehub.dev"
    },
    {
      "key": "memberEmail",
      "value": "member@workspacehub.dev"
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Owner login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('ownerToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
