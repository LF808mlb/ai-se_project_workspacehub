{
  "info": {
    "_postman_id": "0d5b30a8-5c98-46d8-b4be-47f4fdcfe4f0",
    "name": "WorkspaceHub Comment API Adversarial Tests",
    "description": "Unexpected and invalid request tests for the task comment API. Ownership 403 tests are intentionally excluded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "password", "value": "Password123!" },
    { "key": "memberEmail", "value": "member@workspacehub.dev" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Member login succeeds', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('memberToken', data.token);",
                  "pm.collectionVariables.set('memberUserId', data.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find a valid task",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A valid task is available', function () { pm.response.to.have.status(200); });",
                  "const tasks = pm.response.json().data;",
                  "pm.expect(tasks.length).to.be.above(0);",
                  "pm.collectionVariables.set('taskId', tasks[0]._id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication failures",
      "item": [
        {
          "name": "List comments without authorization",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing auth is rejected with 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create comment without authorization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Unauthenticated\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated create is rejected with 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update comment without authorization",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Unauthenticated update\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments/{{missingCommentId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "tasks",
                "{{taskId}}",
                "comments",
                "{{missingCommentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated update is rejected with 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete comment without authorization",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments/{{missingCommentId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "tasks",
                "{{taskId}}",
                "comments",
                "{{missingCommentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated delete is rejected with 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Malformed identifiers",
      "item": [
        {
          "name": "List comments with malformed task ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/not-a-mongo-id/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "not-a-mongo-id", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Malformed task ID is handled as not found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get comment with malformed comment ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments/not-a-mongo-id",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "tasks",
                "{{taskId}}",
                "comments",
                "not-a-mongo-id"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Malformed comment ID is handled as not found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List comments for a valid but nonexistent task",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/000000000000000000000000/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "000000000000000000000000", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unknown task is handled as not found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Body and content-type validation",
      "item": [
        {
          "name": "Create comment with missing content",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing content is rejected with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create comment with whitespace content",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"content\":\"   \"}" },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Whitespace content is rejected with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create comment with non-string content",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"content\":123}" },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Numeric content is rejected with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create comment with JSON sent as text/plain",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "text/plain" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Content type mismatch\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('text/plain body is rejected with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create comment with malformed JSON",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"content\":\"unterminated" },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Malformed JSON is rejected rather than creating a comment', function () { pm.response.to.have.status(500); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Identity, no-op, and idempotency checks",
      "item": [
        {
          "name": "Ignore authorId supplied in request body",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authorId\": \"000000000000000000000000\",\n  \"organizationId\": \"000000000000000000000000\",\n  \"taskId\": \"000000000000000000000000\",\n  \"content\": \"Server must use authenticated identity\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Body injection cannot change author or scope', function () { pm.response.to.have.status(201); });",
                  "const comment = pm.response.json().data;",
                  "pm.expect(comment.authorId).to.eql(pm.collectionVariables.get('memberUserId'));",
                  "pm.expect(comment.taskId).to.eql(pm.collectionVariables.get('taskId'));",
                  "pm.collectionVariables.set('injectedCommentId', comment._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update without content is a no-op",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments/{{injectedCommentId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "tasks",
                "{{taskId}}",
                "comments",
                "{{injectedCommentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing update content leaves the comment unchanged', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json().data.content).to.eql('Server must use authenticated identity');"
                ]
              }
            }
          ]
        },
        {
          "name": "Create duplicate content twice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Duplicate content has no idempotency key\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('First duplicate create succeeds', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('duplicateCommentIdOne', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create duplicate content again",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Duplicate content has no idempotency key\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "comments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Repeated create is accepted as a new comment', function () { pm.response.to.have.status(201); });",
                  "pm.expect(pm.response.json().data._id).not.eql(pm.collectionVariables.get('duplicateCommentIdOne'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete injected comment once",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments/{{injectedCommentId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "tasks",
                "{{taskId}}",
                "comments",
                "{{injectedCommentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('First delete succeeds', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the same comment again",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{memberToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments/{{injectedCommentId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "tasks",
                "{{taskId}}",
                "comments",
                "{{injectedCommentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Repeated delete returns not found rather than deleting again', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
